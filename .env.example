DATABASE_URL="file:./dev.db"

# Required on Vercel. Local falls back to a built-in value.
# SESSION_SECRET=

# Required on Vercel so hourly jobs cannot be called by anyone.
# Vercel Cron sends Authorization: Bearer CRON_SECRET automatically.
# CRON_SECRET=

# Optional public origin for estimate links and webhooks.
# APP_ORIGIN="https://jobcommand.app"

# Maps. Without a key, drive times fall back to OSRM then a Hot Springs estimate.
# GOOGLE_MAPS_API_KEY=
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Estimate delivery. Without these keys, Send still creates the client link and logs email/SMS locally.
# RESEND_API_KEY=
# RESEND_FROM="Job Command <noreply@example.com>"
# Support/contact address shown in the app ("Think this is wrong?" link). Replies to Job Command go here.
# NEXT_PUBLIC_SUPPORT_EMAIL=jobcommandofficial@gmail.com
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# Optional. Whisper / vision when set; otherwise the phone transcript and local paint rates still fill the job.
# AI_GATEWAY_API_KEY=
# OPENAI_API_KEY=

# Stripe card pay on Dark Green, Job Command subscriptions, and Connect payouts.
# Without a key, Company billing still runs a local 30-day trial / mock subscribe / mock bank link.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Optional Price IDs. Without them, checkout sends $199 base and $59 answering price_data (lib/billing.ts).
# If set, STRIPE_PRICE_BASE must be a $199/mo recurring Price so the charge matches the app.
# STRIPE_PRICE_BASE=
# Yearly base plan ($1,990/yr). Without it, yearly checkout sends price_data with interval=year.
# STRIPE_PRICE_BASE_ANNUAL=
# STRIPE_PRICE_ANSWERING=
# Fallback contractor Connect account if the shop has not linked a bank yet.
# STRIPE_CONNECT_ACCOUNT_ID=

# Optional Web Push. First boot can generate VAPID keys.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# FCM_SERVER_KEY=

# Bank-number encryption (go-public B5). 32 random bytes, base64. REQUIRED on Vercel before anyone saves
# direct deposit; keep it forever (losing it = saved bank numbers can't be read). Local dev makes one in .env.local.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# FIELD_ENCRYPTION_KEY=

# AI call answering (lib/answering, Retell AI). Without RETELL_API_KEY, Office › AI answering shows
# "Not connected yet" and every /api/webhooks/retell request is refused (503) — nothing pretends to be live.
# Use the Retell API key that has the webhook badge: it signs x-retell-signature.
# RETELL_API_KEY=
# Public https origin Retell calls back to (webhooks + check_availability/book_estimate functions).
# APP_ORIGIN=https://your-app.example.com
# Optional voice overrides (Retell voice ids). Default: picked from Retell's voice list, male unless Office picks female.
# RETELL_VOICE_MALE=
# RETELL_VOICE_FEMALE=
# Optional Retell LLM model id (default: whatever Retell picks for a new LLM).
# RETELL_LLM_MODEL=
